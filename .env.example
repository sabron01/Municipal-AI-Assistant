# PostgreSQL — remplacer avant usage partagé
POSTGRES_DB=municipal_assistant
POSTGRES_USER=municipal_app
POSTGRES_PASSWORD=CHANGE_ME_LOCAL_ONLY
POSTGRES_PORT=5432

# RustFS — remplacer avant usage partagé
RUSTFS_IMAGE=rustfs/rustfs@sha256:ee717072290bec9b11abfc0365f8310b00df1cd9b3639943edae47bdef05044a
RUSTFS_ACCESS_KEY=CHANGE_ME_RUSTFS_LOCAL
RUSTFS_SECRET_KEY=CHANGE_ME_RUSTFS_SECRET_LOCAL
RUSTFS_API_PORT=9000
RUSTFS_CONSOLE_PORT=9001
RUSTFS_BUCKET_DOCUMENTS=municipal-documents

# Documents backend — uploads remain disabled until size/MIME policy, trusted
# service/category registries and authentication/authorization are configured.
DATABASE_URL=postgresql+psycopg://municipal_app:CHANGE_ME_LOCAL_ONLY@127.0.0.1:5432/municipal_assistant
OBJECT_STORAGE_ENDPOINT=http://localhost:9000
OBJECT_STORAGE_BUCKET=municipal-documents
# Set only after the accepted file formats and maximum size have been decided.
DOCUMENT_MAX_UPLOAD_BYTES=
DOCUMENT_ALLOWED_MEDIA_TYPES=

# Authentification — AUTH_ENABLED reste false jusqu'à configuration SMTP et bootstrap du premier administrateur.
# Les permissions par utilisateur/service sont stockées en base, pas dans l'environnement.
AUTH_LOGIN_IDENTIFIER=email
ACCOUNT_ACTIVATION_LINK_TTL_DAYS=7
ACCOUNT_PASSWORD_RESET_LINK_TTL_DAYS=7
AUTH_MFA_REQUIRED=false
AUTH_ENABLED=false
AUTH_SESSION_TTL_HOURS=8
AUTH_COOKIE_SECURE=true
# Courriel du premier administrateur central; paramètre de bootstrap à retirer après initialisation.
INITIAL_CENTRAL_ADMIN_EMAIL=
# SMTP local simulé par Mailpit (UI http://localhost:8025, SMTP localhost:1025).
# L'envoi non chiffré est autorisé uniquement vers localhost sans identifiants.
APP_PUBLIC_BASE_URL=http://localhost:8000
SMTP_HOST=127.0.0.1
SMTP_PORT=1025
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_SENDER=noreply@municipal.local
SMTP_STARTTLS=false
SMTP_USE_SSL=false
SMTP_ALLOW_INSECURE_LOCAL=true
MAILPIT_SMTP_PORT=1025
MAILPIT_UI_PORT=8025

# Ollama
OLLAMA_PORT=11434
